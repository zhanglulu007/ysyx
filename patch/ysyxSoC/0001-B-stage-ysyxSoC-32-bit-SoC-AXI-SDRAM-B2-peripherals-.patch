+      X_W_SS:       begin wb_adr_i = R_SS;      wb_dat_i = {24'h0, SS_FLASH};           end
+      X_W_CTRL_CFG: begin wb_adr_i = R_CTRL;    wb_dat_i = CTRL_CFG;                    end
+      X_W_CTRL_GO:  begin wb_adr_i = R_CTRL;    wb_dat_i = CTRL_CFG | CTRL_GO;          end
