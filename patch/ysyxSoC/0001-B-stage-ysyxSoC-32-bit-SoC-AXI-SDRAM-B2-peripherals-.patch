+  end else begin
+    case (xst)
+      X_IDLE: begin
+        if (xip_sel && !in_penable) begin
+          flash_addr_r <= {8'b0, in_paddr[23:0]};   
+          xst <= X_W_TX1;
+        end
+      end
+
+      X_W_TX1: begin
+        if (wb_step_done) xst <= X_W_TX0;
+      end
+      X_W_TX0: begin
+        if (wb_step_done) xst <= X_W_DIV;
+      end
+      X_W_DIV: begin
+        if (wb_step_done) xst <= X_W_SS;
+      end
+      X_W_SS: begin
+        if (wb_step_done) xst <= X_W_CTRL_CFG;
+      end
+      X_W_CTRL_CFG: begin
+        if (wb_step_done) xst <= X_W_CTRL_GO;
+      end
+      X_W_CTRL_GO: begin
+        if (wb_step_done) xst <= X_POLL;
