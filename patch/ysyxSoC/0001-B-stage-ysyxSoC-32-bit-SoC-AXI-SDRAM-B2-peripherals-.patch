diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..1e6c3931 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -24,15 +24,88 @@ module apb_delayer(
   input         out_pslverr
 );
 
+  import "DPI-C" function int perf_delay_acc_step();
+
+  localparam integer M = 8;        // 放大系数 s = 2^M
+  localparam [1:0] ST_IDLE    = 2'd0;
+  localparam [1:0] ST_MEASURE = 2'd1;
+  localparam [1:0] ST_DELAY   = 2'd2;
+  localparam [1:0] ST_HOLD    = 2'd3;
+
+  reg [31:0] acc_step;
+  initial begin
+    acc_step = perf_delay_acc_step();
+  end
+
+  reg [1:0]  st;
+  reg [31:0] acc;                  // MEASURE 阶段累加器
+  reg [31:0] cnt;                  // DELAY 阶段剩余拍数
+  reg [31:0] prdata_r;             // 锁存的下游读数据
+  reg        pslverr_r;
+
+  wire passthru = (st == ST_IDLE) || (st == ST_MEASURE);
+
   assign out_paddr   = in_paddr;
-  assign out_psel    = in_psel;
-  assign out_penable = in_penable;
-  assign out_pprot   = in_pprot;
   assign out_pwrite  = in_pwrite;
+  assign out_pprot   = in_pprot;
   assign out_pwdata  = in_pwdata;
   assign out_pstrb   = in_pstrb;
-  assign in_pready   = out_pready;
-  assign in_prdata   = out_prdata;
-  assign in_pslverr  = out_pslverr;
+  assign out_psel    = passthru ? in_psel    : 1'b0;
+  assign out_penable = passthru ? in_penable : 1'b0;
+
+  wire [31:0] acc_next = acc + acc_step;
+  wire [31:0] dly      = acc_next >> M;     // k * (r - 1)
+
+  wire ack = (st == ST_MEASURE && out_pready && (dly == 0)) ||
+             (st == ST_DELAY   && cnt <= 32'd1);
+
+  assign in_pready  = ack;
+  assign in_prdata  = (st == ST_MEASURE && out_pready) ? out_prdata : prdata_r;
+  assign in_pslverr = (st == ST_MEASURE && out_pready) ? out_pslverr : pslverr_r;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      st        <= ST_IDLE;
+      acc       <= 32'b0;
+      cnt       <= 32'b0;
+      prdata_r  <= 32'b0;
+      pslverr_r <= 1'b0;
+    end else begin
+      case (st)
+        ST_IDLE: begin
+          if (in_psel) begin
+            acc <= 32'b0;
+            st  <= ST_MEASURE;
+          end
+        end
+
+        ST_MEASURE: begin
+          if (out_pready) begin          // t1: 设备完成
+            prdata_r  <= out_prdata;     
+            pslverr_r <= out_pslverr;
+            if (dly == 0) begin
+              st <= ST_HOLD;
+            end else begin
+              cnt <= dly;
+              st  <= ST_DELAY;
+            end
+          end else begin
+            acc <= acc + acc_step;
+          end
+        end
+
+        ST_DELAY: begin
+          if (cnt <= 32'd1) st <= ST_HOLD;
+          else              cnt <= cnt - 32'd1;
+        end
+
+        ST_HOLD: begin
+          if (!in_psel) st <= ST_IDLE;   // 等上游撤销请求
+        end
+
+        default: st <= ST_IDLE;
+      endcase
+    end
+  end
 
 endmodule
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index f692803b..3451519a 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -27,7 +27,7 @@ module axi4_delayer(
   input  [31:0] in_wdata,
   input  [3:0]  in_wstrb,
   input         in_wlast,
-                in_bready,
+  input         in_bready,
   output        in_bvalid,
   output [3:0]  in_bid,
   output [1:0]  in_bresp,
@@ -57,40 +57,150 @@ module axi4_delayer(
   output [31:0] out_wdata,
   output [3:0]  out_wstrb,
   output        out_wlast,
-                out_bready,
+  output        out_bready,
   input         out_bvalid,
   input  [3:0]  out_bid,
   input  [1:0]  out_bresp
 );
 
-  assign in_arready = out_arready;
-  assign out_arvalid = in_arvalid;
-  assign out_arid = in_arid;
-  assign out_araddr = in_araddr;
-  assign out_arlen = in_arlen;
-  assign out_arsize = in_arsize;
+  import "DPI-C" function int perf_delay_acc_step();
+
+  localparam integer M = 8;        // 放大系数 s = 2^M
+  localparam [1:0] RD_IDLE = 2'd0, RD_MEASURE = 2'd1, RD_GAP = 2'd2;
+  localparam [1:0] WR_IDLE = 2'd0, WR_MEASURE = 2'd1, WR_WAIT = 2'd2, WR_DONE = 2'd3;
+
+  reg [31:0] acc_step;
+  initial begin
+    acc_step = perf_delay_acc_step();
+  end
+
+  reg [1:0]  rs, ws;               // 读/写通道状态
+  reg [31:0] wacc;                 // 写通道测量累加器
+  reg [31:0] wcnt;                 // 写通道剩余延迟拍数
+
+  assign out_arvalid = in_arvalid && (rs == RD_IDLE);
+  assign in_arready  = out_arready && (rs == RD_IDLE);
+  assign out_arid    = in_arid;
+  assign out_araddr  = in_araddr;
+  assign out_arlen   = in_arlen;
+  assign out_arsize  = in_arsize;
   assign out_arburst = in_arburst;
-  assign out_rready = in_rready;
-  assign in_rvalid = out_rvalid;
-  assign in_rid = out_rid;
-  assign in_rdata = out_rdata;
-  assign in_rresp = out_rresp;
-  assign in_rlast = out_rlast;
-  assign in_awready = out_awready;
-  assign out_awvalid = in_awvalid;
-  assign out_awid = in_awid;
-  assign out_awaddr = in_awaddr;
-  assign out_awlen = in_awlen;
-  assign out_awsize = in_awsize;
+
+  assign out_awvalid = in_awvalid && (ws == WR_IDLE);
+  assign in_awready  = out_awready && (ws == WR_IDLE);
+  assign out_awid    = in_awid;
+  assign out_awaddr  = in_awaddr;
+  assign out_awlen   = in_awlen;
+  assign out_awsize  = in_awsize;
   assign out_awburst = in_awburst;
-  assign in_wready = out_wready;
+
   assign out_wvalid = in_wvalid;
-  assign out_wdata = in_wdata;
-  assign out_wstrb = in_wstrb;
-  assign out_wlast = in_wlast;
-  assign out_bready = in_bready;
-  assign in_bvalid = out_bvalid;
-  assign in_bid = out_bid;
-  assign in_bresp = out_bresp;
+  assign in_wready  = out_wready;
+  assign out_wdata  = in_wdata;
+  assign out_wstrb  = in_wstrb;
+  assign out_wlast  = in_wlast;
+
+  reg [31:0] racc;        // 首 beat 等待期间累计的 (r-1) * 2^M
+  reg [31:0] rcnt;        // 当前剩余阻塞拍数
+  reg        rd_first;    // 本事务尚未消费任何 beat
+
+  wire [31:0] gap_dly  = acc_step >> M;             
+  wire [31:0] head_dly = (racc + acc_step) >> M;
+  wire first_wait = (rs == RD_MEASURE) && rd_first && out_rvalid &&
+                    (rcnt == 32'd0) && (head_dly != 32'd0);
+
+  wire rd_gate = acc_step == 32'd0
+                   ? (rs == RD_MEASURE)                       // r = 1：完全透传
+                   : ((rs == RD_MEASURE) && (rcnt == 32'd0) && !first_wait);
+
+  assign in_rvalid  = rd_gate ? out_rvalid : 1'b0;
+  assign out_rready = rd_gate ? in_rready : 1'b0;
+  assign in_rid     = out_rid;
+  assign in_rdata   = out_rdata;
+  assign in_rresp   = out_rresp;
+  assign in_rlast   = out_rlast;
+
+  wire [31:0] wr_dly   = (wacc + acc_step) >> M;
+  wire        wr_block = (ws == WR_MEASURE) && out_bvalid && (wr_dly != 0);
+  wire        wr_pass  = (ws == WR_IDLE) || (ws == WR_MEASURE) || (ws == WR_DONE);
+
+  assign in_bvalid  = (!wr_pass || wr_block) ? 1'b0 : out_bvalid;
+  assign out_bready = (!wr_pass || wr_block) ? 1'b0 : in_bready;
+  assign in_bid     = out_bid;
+  assign in_bresp   = out_bresp;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      rs   <= RD_IDLE;
+      ws   <= WR_IDLE;
+      racc <= 32'b0;
+      wacc <= 32'b0;
+      rcnt <= 32'b0;
+      wcnt <= 32'b0;
+      rd_first <= 1'b1;
+    end else begin
+      case (rs)
+        RD_IDLE: begin
+          if (in_arvalid && out_arready) begin
+            racc     <= 32'b0;
+            rcnt     <= 32'b0;
+            rd_first <= 1'b1;
+            rs       <= RD_MEASURE;
+          end
+        end
+
+        RD_MEASURE: begin
+          if (rcnt != 32'd0) begin
+            rcnt <= rcnt - 32'd1;
+          end else if (first_wait) begin
+            rcnt     <= head_dly - 32'd1;
+            rd_first <= 1'b0;
+          end else if (out_rvalid && in_rready) begin
+            if (out_rlast) begin
+              rs       <= RD_IDLE;      // 事务结束
+              rd_first <= 1'b1;
+            end else begin
+              // 多 beat：为下一个 beat 插入 (r-1) 拍间隙
+              rcnt     <= gap_dly;
+              rd_first <= 1'b0;
+            end
+          end else begin
+            racc <= racc + acc_step;
+          end
+        end
+
+        default: rs <= RD_IDLE;
+      endcase
+
+      case (ws)
+        WR_IDLE: begin
+          if (in_awvalid && out_awready) begin
+            wacc <= 32'b0;
+            ws   <= WR_MEASURE;
+          end
+        end
+        WR_MEASURE: begin
+          if (out_bvalid) begin
+            if (wr_dly == 0) begin
+              ws <= WR_IDLE;
+            end else begin
+              wcnt <= wr_dly;
+              ws   <= WR_WAIT;
+            end
+          end else begin
+            wacc <= wacc + acc_step;
+          end
+        end
+        WR_WAIT: begin
+          if (wcnt <= 32'd1) ws <= WR_DONE;
+          else               wcnt <= wcnt - 32'd1;
+        end
+        WR_DONE: begin
+          if (out_bvalid && in_bready) ws <= WR_IDLE;
+        end
+        default: ws <= WR_IDLE;
+      endcase
+    end
+  end
 
 endmodule
diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..0f0611d7 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -1,8 +1,42 @@
 module bitrev (
-  input  sck,
-  input  ss,
-  input  mosi,
-  output miso
+  input  sck,    // SPI 时钟 (master 发出)
+  input  ss,     // slave select, 低电平有效
+  input  mosi,   // master out slave in
+  output miso    // master in slave out
 );
-  assign miso = 1'b1;
+
+  reg [3:0] cnt;          
+  reg [7:0] rx_byte;      
+  reg [7:0] tx_byte;      
+  reg       miso_r;       
+
+  always @(*) begin
+    tx_byte[0] = rx_byte[7];
+    tx_byte[1] = rx_byte[6];
+    tx_byte[2] = rx_byte[5];
+    tx_byte[3] = rx_byte[4];
+    tx_byte[4] = rx_byte[3];
+    tx_byte[5] = rx_byte[2];
+    tx_byte[6] = rx_byte[1];
+    tx_byte[7] = rx_byte[0];
+  end
+
+always @(posedge sck or posedge ss) begin
+    if (ss) begin
+      cnt      <= 4'd0;
+      rx_byte  <= 8'd0;
+      miso_r   <= 1'b1;
+    end else begin
+      if (cnt < 4'd8) begin
+        rx_byte <= {rx_byte[6:0], mosi};
+        miso_r  <= 1'b1;
+      end else begin
+        miso_r  <= tx_byte[7 - (cnt - 4'd8)];
+      end
+      cnt <= cnt + 4'd1;
+    end
+  end
+
+  assign miso = miso_r;
+
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..7a67fdf4 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -9,7 +9,7 @@ module gpio_top_apb(
   input  [31:0] in_pwdata,
   input  [3:0]  in_pstrb,
   output        in_pready,
-  output [31:0] in_prdata,
+  output reg [31:0] in_prdata,
   output        in_pslverr,
 
   output [15:0] gpio_out,
@@ -24,4 +24,81 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_7
 );
 
+  reg [15:0] gpio_out_reg;
+  reg [31:0] gpio_seg_reg;     
+
+  wire apb_write_en = in_psel & in_penable & in_pwrite & in_pready;
+
+  wire [3:0] reg_offset = in_paddr[3:0];
+  wire sel_led = (reg_offset == 4'h0);  // 0x0 LED
+  wire sel_sw = (reg_offset == 4'h4);   // 0x4 拨码开关(只读)
+  wire sel_seg = (reg_offset == 4'h8);  // 0x8 数码管
+
+  always @(posedge clock) begin
+    if (reset) begin
+      gpio_out_reg <= 16'b0;
+      gpio_seg_reg <= 32'b0;
+    end else if (apb_write_en) begin
+      if (sel_led) begin
+        if (in_pstrb[0]) gpio_out_reg[7:0] <= in_pwdata[7:0];
+        if (in_pstrb[1]) gpio_out_reg[15:8] <= in_pwdata[15:8];
+      end else if (sel_seg) begin
+        if (in_pstrb[0]) gpio_seg_reg[7:0] <= in_pwdata[7:0];
+        if (in_pstrb[1]) gpio_seg_reg[15:8] <= in_pwdata[15:8];
+        if (in_pstrb[2]) gpio_seg_reg[23:16] <= in_pwdata[23:16];
+        if (in_pstrb[3]) gpio_seg_reg[31:24] <= in_pwdata[31:24];
+      end
+    end
+  end
+  
+  always @(*) begin
+    in_prdata = 32'b0;
+    if (in_psel & in_penable & ~in_pwrite) begin
+      case (reg_offset)
+        4'h0: in_prdata = {16'b0, gpio_out_reg};
+        4'h4: in_prdata = {16'b0, gpio_in};
+        4'h8: in_prdata = gpio_seg_reg;
+        default: in_prdata = 32'b0;
+      endcase
+    end
+  end
+
+  assign in_pready  = 1'b1;
+  assign in_pslverr = 1'b0;
+
+  function [7:0] hex_to_seg;
+    input [3:0] hex;
+    begin
+      case (hex)
+        4'h0: hex_to_seg = 8'b00000011; // 0: A-F on
+        4'h1: hex_to_seg = 8'b10011111; // 1: B-C on
+        4'h2: hex_to_seg = 8'b00100101; // 2: A-B-G-E-D on
+        4'h3: hex_to_seg = 8'b00001101; // 3: A-B-C-D-G on
+        4'h4: hex_to_seg = 8'b10011001; // 4: F-G-B-C on
+        4'h5: hex_to_seg = 8'b01001001; // 5: A-C-D-F-G on
+        4'h6: hex_to_seg = 8'b01000001; // 6: A-C-D-E-F-G on
+        4'h7: hex_to_seg = 8'b00011111; // 7: A-B-C on
+        4'h8: hex_to_seg = 8'b00000001; // 8: all on
+        4'h9: hex_to_seg = 8'b00001001; // 9: A-B-C-D-F-G on
+        4'hA: hex_to_seg = 8'b00010001; // A: A-B-C-E-F-G on
+        4'hB: hex_to_seg = 8'b11000001; // b: C-D-E-F-G on
+        4'hC: hex_to_seg = 8'b01100011; // C: A-D-E-F on
+        4'hD: hex_to_seg = 8'b10000101; // d: B-C-D-E-G on
+        4'hE: hex_to_seg = 8'b01100001; // E: A-D-E-F-G on
+        4'hF: hex_to_seg = 8'b01110001; // F: A-E-F-G on
+        default: hex_to_seg = 8'b11111111; // 全灭
+      endcase
+    end
+  endfunction
+
+  assign gpio_out = gpio_out_reg;
+  assign gpio_seg_0 = hex_to_seg(gpio_seg_reg[3:0]);
+  assign gpio_seg_1 = hex_to_seg(gpio_seg_reg[7:4]);
+  assign gpio_seg_2 = hex_to_seg(gpio_seg_reg[11:8]);
+  assign gpio_seg_3 = hex_to_seg(gpio_seg_reg[15:12]);
+  assign gpio_seg_4 = hex_to_seg(gpio_seg_reg[19:16]);
+  assign gpio_seg_5 = hex_to_seg(gpio_seg_reg[23:20]);
+  assign gpio_seg_6 = hex_to_seg(gpio_seg_reg[27:24]);
+  assign gpio_seg_7 = hex_to_seg(gpio_seg_reg[31:28]);
+
 endmodule
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..8b5a8616 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -16,4 +16,60 @@ module ps2_top_apb(
   input         ps2_data
 );
 
+  reg [2:0] ps2_clk_sync;
+  reg [2:0] ps2_data_sync;
+
+  always @(posedge clock) begin
+    ps2_clk_sync  <= {ps2_clk_sync[1:0],  ps2_clk};
+    ps2_data_sync <= {ps2_data_sync[1:0], ps2_data};
+  end
+
+  wire fall_edge = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+  wire ps2_dat_s = ps2_data_sync[1];
+
+  reg [3:0] count;
+  reg [9:0] buffer;   
+
+  reg [7:0] fifo [0:15];
+  reg [4:0] wptr, rptr;
+
+  wire fifo_full  = (wptr[3:0] == rptr[3:0]) && (wptr[4] != rptr[4]);
+  wire fifo_empty = (wptr == rptr);
+
+  always @(posedge clock) begin
+    if (reset) begin
+      count  <= 4'd0;
+      buffer <= 10'd0;
+      wptr   <= 5'd0;
+    end else if (fall_edge) begin
+      if (count == 4'd10) begin
+        if ((buffer[0] == 1'b0) && (ps2_dat_s == 1'b1) &&
+            (^buffer[9:1]) && !fifo_full) begin
+          fifo[wptr[3:0]] <= buffer[8:1];
+          wptr <= wptr + 5'd1;
+        end
+        count <= 4'd0;     
+      end else begin
+        buffer[count] <= ps2_dat_s;
+        count <= count + 4'd1;
+      end
+    end
+  end
+
+  assign in_pready  = 1'b1;
+  assign in_pslverr = 1'b0;
+
+  wire apb_read_en = in_psel & in_penable & ~in_pwrite;
+  wire sel_data    = (in_paddr[3:0] == 4'h0);
+
+  always @(posedge clock) begin
+    if (reset) begin
+      rptr <= 5'd0;
+    end else if (apb_read_en && sel_data && !fifo_empty) begin
+      rptr <= rptr + 5'd1;
+    end
+  end
+
+  assign in_prdata = (sel_data && !fifo_empty) ? {24'b0, fifo[rptr[3:0]]} : 32'b0;
+
 endmodule
diff --git a/perip/psram/efabless/EF_PSRAM_CTRL.v b/perip/psram/efabless/EF_PSRAM_CTRL.v
index b6e737e9..20d5540b 100644
--- a/perip/psram/efabless/EF_PSRAM_CTRL.v
+++ b/perip/psram/efabless/EF_PSRAM_CTRL.v
@@ -47,6 +47,7 @@ module PSRAM_READER (
     input   wire [23:0]     addr,
     input   wire            rd,
     input   wire [2:0]      size,
+    input   wire            qpi_mode,
     output  wire            done,
     output  wire [31:0]     line,
 
@@ -60,7 +61,7 @@ module PSRAM_READER (
     localparam  IDLE = 1'b0,
                 READ = 1'b1;
 
-    wire [7:0]  FINAL_COUNT = 19 + size*2; // was 27: Always read 1 word
+    wire [7:0]  FINAL_COUNT = qpi_mode ? 13 + size*2 : 19 + size*2;
 
