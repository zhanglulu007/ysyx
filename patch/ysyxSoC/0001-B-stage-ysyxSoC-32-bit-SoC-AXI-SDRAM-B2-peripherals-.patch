+          if (~dqm[0]) mem[burst_bank][active_row[burst_bank]][burst_col + 1][7:0]  <= dq[7:0];
+          if (~dqm[1]) mem[burst_bank][active_row[burst_bank]][burst_col + 1][15:8] <= dq[15:8];
+          burst_rem <= burst_rem - 1;
+        end else if (burst_rem == 0) begin
+          burst_active <= 1'b0;
+        end
+      end
+    end else begin
+      // cke=0: clock suspend
+    end
+  end
+
+  reg        dq_out_en;
+  reg [15:0] dq_out;
+
+  always @(*) begin
+    dq_out_en = 1'b0;
+    dq_out    = 16'b0;
+
+    // Select the correct pipeline stage based on CAS latency
+    if (cl_dly == 3'd1 && rd_valid[0]) begin dq_out_en = 1'b1; dq_out = rd_pipe[0]; end
+    if (cl_dly == 3'd2 && rd_valid[1]) begin dq_out_en = 1'b1; dq_out = rd_pipe[1]; end
+    if (cl_dly == 3'd3 && rd_valid[2]) begin dq_out_en = 1'b1; dq_out = rd_pipe[2]; end
+  end
+
+  assign dq = dq_out_en ? dq_out : 16'bz;
+
+endmodule
