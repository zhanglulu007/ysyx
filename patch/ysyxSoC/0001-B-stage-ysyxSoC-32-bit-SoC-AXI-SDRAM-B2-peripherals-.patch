diff --git a/perip/vga/vga_top_apb.v b/perip/vga/vga_top_apb.v
index 5c74cfbe..44add4b8 100644
--- a/perip/vga/vga_top_apb.v
+++ b/perip/vga/vga_top_apb.v
@@ -20,4 +20,72 @@ module vga_top_apb(
   output        vga_valid
 );
 
+  localparam H_RES = 640;
+  localparam V_RES = 480;
+
+  localparam H_FRONT_PORCH = 96;
+  localparam H_ACTIVE = 144;   // 同步脉冲后沿起点 = 前沿 + 同步宽度
+  localparam H_BACK_PORCH = 784;   // 显示结束 = H_ACTIVE + H_RES
+  localparam H_TOTAL = 800;
+  localparam V_FRONT_PORCH = 2;
+  localparam V_ACTIVE = 35;
+  localparam V_BACK_PORCH = 515;
+  localparam V_TOTAL = 525;
+
+  reg [31:0] fb [0:524287];   
+
+  wire apb_write_en = in_psel & in_penable & in_pwrite & in_pready;
+  wire [18:0] fb_waddr_a = in_paddr[20:2];      // 2MB/4 = 512K 字
+  wire [31:0] fb_wdata_a = in_pwdata;
+
+  reg [9:0] h_cnt;
+  reg [9:0] v_cnt;
+
+  wire h_active = (h_cnt > H_ACTIVE) && (h_cnt <= H_BACK_PORCH);
+  wire v_active = (v_cnt > V_ACTIVE) && (v_cnt <= V_BACK_PORCH);
+  wire h_sync_n = (h_cnt > H_FRONT_PORCH);
+  wire v_sync_n = (v_cnt > V_FRONT_PORCH);
+  wire in_display = h_active && v_active;
+
+  wire [9:0] pixel_x = h_cnt - (H_ACTIVE + 1);
+  wire [9:0] pixel_y = v_cnt - (V_ACTIVE + 1);
+
+  wire [18:0] fb_raddr_b = in_display ? ({9'd0, pixel_y} * H_RES + {9'd0, pixel_x}) : 19'd0;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      h_cnt <= 10'd1;
+      v_cnt <= 10'd1;
+    end else begin
+      if (h_cnt == H_TOTAL) begin
+        h_cnt <= 10'd1;
+        if (v_cnt == V_TOTAL) v_cnt <= 10'd1;
+        else v_cnt <= v_cnt + 10'd1;
+      end else begin
+        h_cnt <= h_cnt + 10'd1;
+      end
+    end
+  end
+
+  always @(posedge clock) begin
+    if (apb_write_en) begin
+      if (in_pstrb[0]) fb[fb_waddr_a][7:0] <= fb_wdata_a[7:0];
+      if (in_pstrb[1]) fb[fb_waddr_a][15:8] <= fb_wdata_a[15:8];
+      if (in_pstrb[2]) fb[fb_waddr_a][23:16] <= fb_wdata_a[23:16];
+      if (in_pstrb[3]) fb[fb_waddr_a][31:24] <= fb_wdata_a[31:24];
+    end
+  end
+
+  wire [31:0] pixel_data = fb[fb_raddr_b];
+
+  assign vga_r = in_display ? pixel_data[23:16] : 8'h00;
+  assign vga_g = in_display ? pixel_data[15:8] : 8'h00;
+  assign vga_b = in_display ? pixel_data[7:0] : 8'h00;
+  assign vga_hsync = h_sync_n;
+  assign vga_vsync = v_sync_n;
+  assign vga_valid = in_display; 
+  assign in_pready = 1'b1;
+  assign in_pslverr = 1'b0;
+  assign in_prdata = 32'b0;
+
 endmodule
