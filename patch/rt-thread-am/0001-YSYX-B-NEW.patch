diff --git a/bsp/abstract-machine/extra-ysyxsoc.ld b/bsp/abstract-machine/extra-ysyxsoc.ld
new file mode 100644
index 000000000..54b0f87b0
--- /dev/null
+++ b/bsp/abstract-machine/extra-ysyxsoc.ld
@@ -0,0 +1,49 @@
+SECTIONS {
+  .data.extra : {
+    _data_extra_start = .;
+
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+    . = ALIGN(8);
+
+    . = ALIGN(8);
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+    . = ALIGN(8);
+
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+    . = ALIGN(8);
+    _data_extra_end = .;
+
+  } > SDRAM AT> FLASH
+  _data_extra_lma = LOADADDR(.data.extra);
+} INSERT BEFORE .data;
+
+SECTIONS {
+  .bss.extra (NOLOAD) : {
+    _bss_extra_start = .;
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+    . = ALIGN(8);
+    _bss_extra_end = .;
+  } > SDRAM
+} INSERT BEFORE .bss;
