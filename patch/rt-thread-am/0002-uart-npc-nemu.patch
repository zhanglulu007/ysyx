---
 bsp/abstract-machine/src/uart.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/bsp/abstract-machine/src/uart.c b/bsp/abstract-machine/src/uart.c
index b6c6b2fb3..711cd2579 100644
--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -32,8 +32,20 @@ static rt_err_t _uart_control(struct rt_serial_device *serial, int cmd, void *ar
   return (RT_EOK);
 }
 
+static bool _uart_am_io_available(void) {
+  static int8_t flag = -1;
+  if (flag < 0) {
+    flag = io_read(AM_UART_CONFIG).present ? 1 : 0;
+  }
+  return flag == 1;
+}
+
 static int _uart_putc(struct rt_serial_device *serial, char c) {
-  io_write(AM_UART_TX, .data = c);
+  if (_uart_am_io_available()) {
+    io_write(AM_UART_TX, .data = c);
+  } else {
+    putch(c);
+  }
   return 1;
 }
 
@@ -41,6 +53,8 @@ static int _uart_getc(struct rt_serial_device *serial) {
   static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
   if (*p != '\0') { return *(p ++); }
 
+  if (!_uart_am_io_available()) { return -1; }
+
   char ch = io_read(AM_UART_RX).data;
   return (ch != 0xFF) ? (int)(unsigned char)ch : -1;
 }
